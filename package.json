    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.9"
  },
  "volta": {
    "node": "24.14.0"
